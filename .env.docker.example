# Copy this file to .env before running the containerized app stack.
# The database itself must already exist. Prisma migrations create the tables.
# Always include ?schema=public in the PostgreSQL connection string.
#
# If PostgreSQL runs on your host machine, use host.docker.internal from inside
# containers on macOS/Windows. On Linux, docker-compose.yml maps that hostname to
# the Docker host gateway.
DATABASE_URL="postgresql://postgres:postgres@host.docker.internal:5432/project_tracker?schema=public"
JWT_SECRET="change-me-to-a-long-random-secret"
PORT=4000
CORS_ORIGIN="http://localhost:8080"
UPLOAD_DIR="/app/apps/api/uploads"
STORAGE_DRIVER=local
# S3-compatible storage settings (used only with STORAGE_DRIVER=s3).
# docker-compose.minio.yml uses http://minio:9000 and local-only credentials.
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_BUCKET="project-tracker-attachments"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true
S3_USE_PRESIGNED_URLS=false
# Set this only when presigned URLs should use a browser-accessible endpoint.
S3_PUBLIC_URL=""
NOTIFICATION_SCAN_INTERVAL_MS=900000

# The web Docker image is built with VITE_API_URL=/api so the nginx reverse proxy
# can forward browser requests to the API service. You normally do not need to set
# VITE_API_URL for docker compose.
#
# If you also start docker-compose.db.yml, update DATABASE_URL to point at the
# optional in-stack database service instead:
# DATABASE_URL="postgresql://postgres:postgres@postgres:5432/project_tracker?schema=public"
